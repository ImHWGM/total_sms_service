pipeline {
    agent any

    tools {
        maven "maven 3.9.5"
        jdk 'jdk-21.0.2'
    }

    stages {
        stage('GitHub Clone') {
            steps {
                git credentialsId: 'syscuss_admin',
                    url: 'https://gitea.syscuss.com/Syscuss/SYSCUSS_BE_WiseAd.git',
                    branch: 'main'
            }
        }

        stage('Build') {
            steps {
                // maven-install-plugin이 initialize 단계에서 외부 JAR(libs/) 자동 설치
                bat 'mvn -U clean install -Dspring.profiles.active=prod -DskipTests'
            }
        }

        stage('Deploy') {
            steps {
                // 민감 정보는 Jenkins Credentials(Secret text)에 보관하고 런타임에 환경변수로 주입한다.
                // 코드/properties 에는 평문 시크릿을 남기지 않는다 (${ENV} 플레이스홀더만 존재).
                // 아래 credentialsId 는 [상용] Jenkins > Manage Credentials(Global) 에 Secret text 로 등록한 ID 와 일치해야 한다.
                withCredentials([
                    string(credentialsId: 'DB_PRIMARY_USERNAME',      variable: 'DB_PRIMARY_USERNAME'),
                    string(credentialsId: 'DB_PRIMARY_PASSWORD',      variable: 'DB_PRIMARY_PASSWORD'),
                    string(credentialsId: 'DB_SMS_USERNAME',          variable: 'DB_SMS_USERNAME'),
                    string(credentialsId: 'DB_SMS_PASSWORD',          variable: 'DB_SMS_PASSWORD'),
                    string(credentialsId: 'JWT_SECRET',               variable: 'JWT_SECRET'),
                    string(credentialsId: 'AUTH_SESSION_KEY_SECRET',  variable: 'AUTH_SESSION_KEY_SECRET'),
                    string(credentialsId: 'MAIL_HIWORKS_OFFICE_TOKEN',variable: 'MAIL_HIWORKS_OFFICE_TOKEN'),
                    string(credentialsId: 'SMS_API_ID',               variable: 'SMS_API_ID'),
                    string(credentialsId: 'SMS_API_PW',               variable: 'SMS_API_PW'),
                    string(credentialsId: 'SMS_API_CLIENT_ID',        variable: 'SMS_API_CLIENT_ID'),
                    string(credentialsId: 'SMS_API_CLIENT_SECRET',    variable: 'SMS_API_CLIENT_SECRET'),
                    string(credentialsId: 'KCP_ENC_KEY',              variable: 'KCP_ENC_KEY'),
                    string(credentialsId: 'ENC_DATA_KEY',             variable: 'ENC_DATA_KEY'),
                    string(credentialsId: 'ENC_DATA_KEY_LEGACY',      variable: 'ENC_DATA_KEY_LEGACY')
                ]) {
                    bat 'java -jar -Dspring.profiles.active=prod -Dserver.port=8100 target/wisead-0.0.1-SNAPSHOT.jar'
                }
            }
        }
    }
}