<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.wisead.mapper.primary.StandardRateMapper">

    <!-- 전체 기준 단가 목록 조회 -->
    <select id="selectStandardRates" resultType="kr.wisead.domain.payment.entity.StandardRate">
        SELECT
            service_seq         AS serviceSeq,
            service_id          AS serviceId,
            service_name        AS serviceName,
            service_rate        AS serviceRate,
            service_description AS serviceDescription
        FROM
            standard_rate
    </select>

    <!-- 서비스 ID로 기준 단가 조회 -->
    <select id="selectStandardRateByServiceId" resultType="java.math.BigDecimal">
        SELECT
            service_rate
        FROM
            standard_rate
        WHERE
            service_id = #{serviceId}
    </select>

</mapper>
