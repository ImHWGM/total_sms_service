<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.wisead.mapper.primary.AuditEventMapper">

    <!-- AuditEvent ResultMap -->
    <resultMap id="AuditEventResultMap" type="kr.wisead.domain.audit.entity.AuditEvent">
        <id property="seq" column="SEQ"/>
        <result property="eventType" column="EVENT_TYPE"/>
        <result property="userId" column="USER_ID"/>
        <result property="actorId" column="ACTOR_ID"/>
        <result property="actorType" column="ACTOR_TYPE"/>
        <result property="ip" column="IP"/>
        <result property="userAgent" column="USER_AGENT"/>
        <result property="reason" column="REASON"/>
        <result property="prevStatus" column="PREV_STATUS"/>
        <result property="newStatus" column="NEW_STATUS"/>
        <result property="metadata" column="METADATA"/>
        <result property="createdAt" column="CREATED_AT"/>
    </resultMap>

    <!-- 감사 이벤트 기록 -->
    <insert id="insert" parameterType="kr.wisead.domain.audit.entity.AuditEvent"
            useGeneratedKeys="true" keyProperty="seq">
        INSERT INTO audit_event (
            EVENT_TYPE, USER_ID, ACTOR_ID, ACTOR_TYPE,
            IP, USER_AGENT, REASON,
            PREV_STATUS, NEW_STATUS, METADATA
        ) VALUES (
            #{eventType}, #{userId}, #{actorId}, #{actorType},
            #{ip}, #{userAgent}, #{reason},
            #{prevStatus}, #{newStatus}, #{metadata}
        )
    </insert>

    <!-- 필터 조건 감사 이벤트 목록 조회 -->
    <select id="selectByFilter" resultMap="AuditEventResultMap">
        SELECT SEQ, EVENT_TYPE, USER_ID, ACTOR_ID, ACTOR_TYPE,
               IP, USER_AGENT, REASON, PREV_STATUS, NEW_STATUS, METADATA, CREATED_AT
        FROM audit_event
        <where>
            <if test="eventType != null and eventType != ''">
                AND EVENT_TYPE = #{eventType}
            </if>
            <if test="userId != null">
                AND USER_ID = #{userId}
            </if>
            <if test="from != null">
                AND CREATED_AT >= #{from}
            </if>
            <if test="to != null">
                AND CREATED_AT &lt;= #{to}
            </if>
        </where>
        ORDER BY CREATED_AT DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 필터 조건 감사 이벤트 총 건수 -->
    <select id="countByFilter" resultType="long">
        SELECT COUNT(*)
        FROM audit_event
        <where>
            <if test="eventType != null and eventType != ''">
                AND EVENT_TYPE = #{eventType}
            </if>
            <if test="userId != null">
                AND USER_ID = #{userId}
            </if>
            <if test="from != null">
                AND CREATED_AT >= #{from}
            </if>
            <if test="to != null">
                AND CREATED_AT &lt;= #{to}
            </if>
        </where>
    </select>

</mapper>
