<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.wisead.mapper.sms.SendHistoryMapper">

    <resultMap id="sendHistoryResultMap" type="kr.wisead.domain.history.entity.SendHistory">
        <id property="msgKey" column="MSEQ"/>
        <result property="msgType" column="MSG_TYPE"/>
        <result property="dstAddr" column="DSTADDR"/>
        <result property="callBack" column="CALLBACK"/>
        <result property="subject" column="SUBJECT"/>
        <result property="text" column="TEXT"/>
        <result property="stat" column="STAT"/>
        <result property="result" column="RESULT"/>
        <result property="fileCnt" column="FILECNT"/>
        <result property="fileLoc1" column="FILELOC1"/>
        <result property="requestTime" column="REQUEST_TIME"/>
        <result property="sendTime" column="SEND_TIME"/>
        <result property="reportTime" column="REPORT_TIME"/>
        <result property="telecom" column="TELECOM"/>
        <result property="extCol2" column="EXT_COL2"/>
        <result property="extCol3" column="EXT_COL3"/>
    </resultMap>

    <sql id="selectColumns">
        MSEQ,
        MSG_TYPE,
        DSTADDR,
        CALLBACK,
        SUBJECT,
        TEXT,
        STAT,
        RESULT,
        FILECNT,
        FILELOC1,
        REQUEST_TIME,
        SEND_TIME,
        REPORT_TIME,
        TELECOM,
        EXT_COL2,
        EXT_COL3
    </sql>

    <sql id="whereCondition">
        <where>
            1=1
            <if test="params.startDate != null and params.startDate != ''">
                AND REQUEST_TIME &gt;= #{params.startDate}
            </if>
            <if test="params.endDate != null and params.endDate != ''">
                AND REQUEST_TIME &lt;= #{params.endDate}
            </if>
            <if test="params.sendFailure == 'Y'">
                AND STAT = 3
            </if>
            <if test="params.userId != null and params.userId != '' and params.userId != 'ALL'">
                <choose>
                    <when test="params.userId.indexOf(',') >= 0">
                        AND EXT_COL3 IN
                        <foreach item="id" collection="params.userId.split(',')" open="(" separator="," close=")">
                            #{id}
                        </foreach>
                    </when>
                    <otherwise>
                        AND EXT_COL3 = #{params.userId}
                    </otherwise>
                </choose>
            </if>
            <if test="params.keyword != null and params.keyword != ''">
                <choose>
                    <!-- A: 메시지타입 -->
                    <when test="params.type == 'A'">
                        AND MSG_TYPE LIKE CONCAT('%', #{params.keyword}, '%')
                    </when>
                    <!-- B: 수신번호 -->
                    <when test="params.type == 'B' or params.type == 'dstAddr'">
                        AND DSTADDR LIKE CONCAT('%', #{params.keyword}, '%')
                    </when>
                    <!-- C: 발신번호 -->
                    <when test="params.type == 'C' or params.type == 'callBack'">
                        AND CALLBACK LIKE CONCAT('%', #{params.keyword}, '%')
                    </when>
                    <!-- D: 제목 -->
                    <when test="params.type == 'D' or params.type == 'subject'">
                        AND SUBJECT LIKE CONCAT('%', #{params.keyword}, '%')
                    </when>
                    <!-- E: 내용 -->
                    <when test="params.type == 'E' or params.type == 'text'">
                        AND TEXT LIKE CONCAT('%', #{params.keyword}, '%')
                    </when>
                    <!-- F: 상태 -->
                    <when test="params.type == 'F'">
                        AND STAT = #{params.keyword}
                    </when>
                    <!-- G: 등록자 -->
                    <when test="params.type == 'G'">
                        AND EXT_COL3 LIKE CONCAT('%', #{params.keyword}, '%')
                    </when>
                    <!-- H: 결과 -->
                    <when test="params.type == 'H'">
                        AND RESULT LIKE CONCAT('%', #{params.keyword}, '%')
                    </when>
                    <otherwise>
                        AND (
                            DSTADDR LIKE CONCAT('%', #{params.keyword}, '%')
                            OR CALLBACK LIKE CONCAT('%', #{params.keyword}, '%')
                            OR SUBJECT LIKE CONCAT('%', #{params.keyword}, '%')
                        )
                    </otherwise>
                </choose>
            </if>
        </where>
    </sql>

    <!-- 발송 이력 목록 조회 (동적 테이블명) -->
    <select id="selectList" resultMap="sendHistoryResultMap">
        SELECT
            <include refid="selectColumns"/>
        FROM ${tableName}
        <include refid="whereCondition"/>
        ORDER BY REQUEST_TIME DESC
        LIMIT #{params.offset}, #{params.size}
    </select>

    <!-- 발송 이력 총 건수 -->
    <select id="selectCount" resultType="int">
        SELECT COUNT(*)
        FROM ${tableName}
        <include refid="whereCondition"/>
    </select>

    <!-- 발송 이력 전체 조회 (다운로드용) -->
    <select id="selectAllForDownload" resultMap="sendHistoryResultMap">
        SELECT
            <include refid="selectColumns"/>
        FROM ${tableName}
        <include refid="whereCondition"/>
        ORDER BY REQUEST_TIME DESC
    </select>

    <!-- 전화번호로 최근 발송자 ID 조회 (동적 테이블명) - ARS 자동등록형 -->
    <select id="selectUserIdByAni" resultType="String">
        SELECT EXT_COL3
        FROM msg_result_${tableName}
        WHERE DSTADDR = #{ani}
        LIMIT 1
    </select>

</mapper>
