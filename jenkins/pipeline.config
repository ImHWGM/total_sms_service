pipeline {
    agent any

    tools {
        maven "maven 3.9.5"
        jdk 'jdk-21.0.2'
    }

    stages {
        stage('GitHub Clone') {
            steps {
                git credentialsId: 'ihwgm',
                    url: 'https://git.syscuss.com:3001/ihwgm/BE_New_WiseAd_SYSCUSS.git',
                    branch: 'dev'
            }
        }

        stage('Build') {
            steps {
                // maven-install-plugin이 initialize 단계에서 외부 JAR(libs/) 자동 설치
                bat 'mvn clean install -Dspring.profiles.active=dev -DskipTests'
            }
        }

        stage('Deploy') {
            steps {
                // 민감 정보는 Jenkins Credentials(Secret text)에 보관하고 런타임에 환경변수로 주입한다.
                // 코드/properties 에는 평문 시크릿을 남기지 않는다 (${ENV} 플레이스홀더만 존재).
                // 아래 credentialsId 들은 [개발서버] Jenkins > Manage Credentials 에 Secret text 로 사전 등록되어 있어야 한다.
                withCredentials([
                    string(credentialsId: 'wisead-db-primary-username',      variable: 'DB_PRIMARY_USERNAME'),
                    string(credentialsId: 'wisead-db-primary-password',      variable: 'DB_PRIMARY_PASSWORD'),
                    string(credentialsId: 'wisead-db-sms-username',          variable: 'DB_SMS_USERNAME'),
                    string(credentialsId: 'wisead-db-sms-password',          variable: 'DB_SMS_PASSWORD'),
                    string(credentialsId: 'wisead-jwt-secret',               variable: 'JWT_SECRET'),
                    string(credentialsId: 'wisead-auth-session-key-secret',  variable: 'AUTH_SESSION_KEY_SECRET'),
                    string(credentialsId: 'wisead-mail-hiworks-office-token',variable: 'MAIL_HIWORKS_OFFICE_TOKEN'),
                    string(credentialsId: 'wisead-sms-api-id',               variable: 'SMS_API_ID'),
                    string(credentialsId: 'wisead-sms-api-pw',               variable: 'SMS_API_PW'),
                    string(credentialsId: 'wisead-sms-api-client-id',        variable: 'SMS_API_CLIENT_ID'),
                    string(credentialsId: 'wisead-sms-api-client-secret',    variable: 'SMS_API_CLIENT_SECRET'),
                    string(credentialsId: 'wisead-kcp-enc-key',              variable: 'KCP_ENC_KEY')
                ]) {
                    bat 'java -jar -Dspring.profiles.active=dev -Dserver.port=8100 target/wisead-0.0.1-SNAPSHOT.jar'
                }
            }
        }
    }
}