<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.wisead.mapper.sms.SendHistoryMapper">

    <resultMap id="sendHistoryResultMap" type="kr.wisead.domain.history.entity.SendHistory">
        <id property="msgKey" column="MSEQ"/>
        <result property="msgType" column="MSG_TYPE"/>
        <result property="dstAddr" column="DSTADDR"/>
        <result property="callBack" column="CALLBACK"/>
        <result property="subject" column="SUBJECT"/>
        <result property="text" column="TEXT"/>
        <result property="stat" column="STAT"/>
        <result property="result" column="RESULT"/>
        <result property="fileCnt" column="FILECNT"/>
        <result property="fileLoc1" column="FILELOC1"/>
        <result property="requestTime" column="REQUEST_TIME"/>
        <result property="sendTime" column="SEND_TIME"/>
        <result property="reportTime" column="REPORT_TIME"/>
        <result property="telecom" column="TELECOM"/>
        <result property="extCol2" column="EXT_COL2"/>
        <result property="extCol3" column="EXT_COL3"/>
    </resultMap>

    <sql id="selectColumns">
        MSEQ,
        MSG_TYPE,
        DSTADDR,
        CALLBACK,
        SUBJECT,
        TEXT,
        STAT,
        RESULT,
        FILECNT,
        FILELOC1,
        REQUEST_TIME,
        SEND_TIME,
        REPORT_TIME,
        TELECOM,
        EXT_COL2,
        EXT_COL3
    </sql>

    <sql id="whereCondition">
        <where>
            1=1
            <if test="params.startDate != null and params.startDate != ''">
                AND REQUEST_TIME &gt;= #{params.startDate}
            </if>
            <if test="params.endDate != null and params.endDate != ''">
                AND REQUEST_TIME &lt; CONCAT(#{params.endDate}, ' 00:00:00')
            </if>
            <if test="params.sendResult == 'failure'.toString()">
                AND STAT = 3 AND RESULT NOT IN ('0', '1000')
            </if>
            <if test="params.sendResult == 'success'.toString()">
                AND STAT = 3 AND RESULT IN ('0', '1000')
            </if>
            <!-- [legacy] 구버전 FE 실패 필터(sendResult 없고 sendFailure=Y일 때만). FE 배포 후 제거 -->
            <if test="(params.sendResult == null or params.sendResult == '') and params.sendFailure == 'Y'.toString()">
                AND STAT = 3 AND RESULT NOT IN ('0', '1000')
            </if>
            <if test="params.userId != null and params.userId != '' and params.userId != 'ALL'.toString()">
                <choose>
                    <when test="params.userId.indexOf(',') >= 0">
                        AND EXT_COL3 IN
                        <foreach item="id" collection="params.userId.split(',')" open="(" separator="," close=")">
                            #{id}
                        </foreach>
                    </when>
                    <otherwise>
                        AND EXT_COL3 = #{params.userId}
                    </otherwise>
                </choose>
            </if>
            <if test="params.keyword != null and params.keyword != ''">
                <choose>
                    <!-- A: 메시지타입 -->
                    <when test="params.type == 'A'.toString()">
                        AND MSG_TYPE LIKE CONCAT('%', #{params.keyword}, '%')
                    </when>
                    <!-- B: 수신번호 -->
                    <when test="params.type == 'B'.toString() or params.type == 'dstAddr'">
                        AND DSTADDR LIKE CONCAT('%', #{params.keyword}, '%')
                    </when>
                    <!-- C: 발신번호 -->
                    <when test="params.type == 'C'.toString() or params.type == 'callBack'">
                        AND CALLBACK LIKE CONCAT('%', #{params.keyword}, '%')
                    </when>
                    <!-- D: 제목 -->
                    <when test="params.type == 'D'.toString() or params.type == 'subject'">
                        AND SUBJECT LIKE CONCAT('%', #{params.keyword}, '%')
                    </when>
                    <!-- E: 내용 -->
                    <when test="params.type == 'E'.toString() or params.type == 'text'">
                        AND TEXT LIKE CONCAT('%', #{params.keyword}, '%')
                    </when>
                    <!-- F: 상태 -->
                    <when test="params.type == 'F'.toString()">
                        AND STAT = #{params.keyword}
                    </when>
                    <!-- G: 등록자 -->
                    <when test="params.type == 'G'.toString()">
                        AND EXT_COL3 LIKE CONCAT('%', #{params.keyword}, '%')
                    </when>
                    <!-- [legacy] H: 결과(구버전 성공필터, sendResult 없고 keyword=0일 때만). FE 배포 후 제거 -->
                    <when test="(params.sendResult == null or params.sendResult == '') and params.type == 'H'.toString() and params.keyword == '0'.toString()">
                        AND STAT = 3 AND RESULT IN ('0', '1000')
                    </when>
                    <otherwise>
                        AND (
                            DSTADDR LIKE CONCAT('%', #{params.keyword}, '%')
                            OR CALLBACK LIKE CONCAT('%', #{params.keyword}, '%')
                            OR SUBJECT LIKE CONCAT('%', #{params.keyword}, '%')
                        )
                    </otherwise>
                </choose>
            </if>
        </where>
    </sql>

    <!-- 발송 이력 목록 조회 (동적 테이블명) -->
    <select id="selectList" resultMap="sendHistoryResultMap">
        SELECT
            <include refid="selectColumns"/>
        FROM ${tableName}
        <include refid="whereCondition"/>
        ORDER BY REQUEST_TIME DESC
        LIMIT #{params.offset}, #{params.size}
    </select>

    <!-- 발송 이력 총 건수 -->
    <select id="selectCount" resultType="int">
        SELECT COUNT(*)
        FROM ${tableName}
        <include refid="whereCondition"/>
    </select>

    <!-- 발송 이력 전체 조회 (다운로드용) -->
    <select id="selectAllForDownload" resultMap="sendHistoryResultMap">
        SELECT
            <include refid="selectColumns"/>
        FROM ${tableName}
        <include refid="whereCondition"/>
        ORDER BY REQUEST_TIME DESC
    </select>

    <!-- seq(MSEQ) 단건 조회 (원본 수신번호 조회용, 권한 범위 필터 포함) -->
    <select id="selectBySeq" resultMap="sendHistoryResultMap">
        SELECT
            <include refid="selectColumns"/>
        FROM ${tableName}
        WHERE MSEQ = #{seq}
        <if test="userId != null and userId != '' and userId != 'ALL'.toString()">
            <choose>
                <when test="userId.indexOf(',') >= 0">
                    AND EXT_COL3 IN
                    <foreach item="id" collection="userId.split(',')" open="(" separator="," close=")">
                        #{id}
                    </foreach>
                </when>
                <otherwise>
                    AND EXT_COL3 = #{userId}
                </otherwise>
            </choose>
        </if>
        LIMIT 1
    </select>

    <!-- 전화번호로 최근 발송자 ID 조회 (동적 테이블명) - ARS 자동등록형 -->
    <select id="selectUserIdByAni" resultType="String">
        SELECT EXT_COL3
        FROM msg_result_${tableName}
        WHERE DSTADDR = #{ani}
        LIMIT 1
    </select>

    <!-- 행사별 발송 결과 통계 (EXT_COL0 = eventSeq) -->
    <select id="selectMessageStatsByEventSeq" resultType="map">
        SELECT
            COUNT(*) as totalSent,
            SUM(CASE WHEN RESULT IN ('0', '1000') THEN 1 ELSE 0 END) as successCount,
            SUM(CASE WHEN RESULT IS NOT NULL AND RESULT NOT IN ('0', '1000') THEN 1 ELSE 0 END) as failCount
        FROM ${tableName}
        WHERE EXT_COL0 = #{eventSeq}
    </select>

</mapper>
