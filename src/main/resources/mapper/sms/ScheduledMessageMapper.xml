<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.wisead.mapper.sms.ScheduledMessageMapper">

    <resultMap id="scheduledMessageResultMap" type="kr.wisead.domain.schedule.entity.ScheduledMessage">
        <id property="mSeq" column="M_SEQ"/>
        <result property="msgType" column="MSG_TYPE"/>
        <result property="dstAddr" column="DST_ADDR"/>
        <result property="callBack" column="CALLBACK"/>
        <result property="stat" column="STAT"/>
        <result property="subject" column="SUBJECT"/>
        <result property="text" column="TEXT"/>
        <result property="insertTime" column="INSERT_TIME"/>
        <result property="requestTime" column="REQUEST_TIME"/>
        <result property="senderCode" column="SENDER_CODE"/>
        <result property="extCol0" column="EXT_COL0"/>
        <result property="extCol1" column="EXT_COL1"/>
        <result property="extCol2" column="EXT_COL2"/>
        <result property="extCol3" column="EXT_COL3"/>
        <result property="messageCount" column="MESSAGE_COUNT"/>
        <result property="fileCnt" column="FILE_CNT"/>
        <result property="fileLoc1" column="FILE_LOC1"/>
        <result property="fileLoc2" column="FILE_LOC2"/>
        <result property="fileLoc3" column="FILE_LOC3"/>
        <result property="fileLoc4" column="FILE_LOC4"/>
        <result property="fileLoc5" column="FILE_LOC5"/>
    </resultMap>

    <sql id="whereCondition">
        <where>
            STAT = 0
            AND REQUEST_TIME > NOW()
            <if test="userId != null and userId != '' and userId != 'ALL'">
                <choose>
                    <when test="userId.contains(',')">
                        AND EXT_COL3 IN
                        <foreach item="id" collection="userId.split(',')" open="(" separator="," close=")">
                            #{id}
                        </foreach>
                    </when>
                    <otherwise>
                        AND EXT_COL3 = #{userId}
                    </otherwise>
                </choose>
            </if>
            <if test="msgType != null and msgType != ''">
                AND MSG_TYPE = #{msgType}
            </if>
            <if test="searchText != null and searchText != ''">
                AND (
                    DST_ADDR LIKE CONCAT('%', #{searchText}, '%')
                    OR CALLBACK LIKE CONCAT('%', #{searchText}, '%')
                    OR SUBJECT LIKE CONCAT('%', #{searchText}, '%')
                    OR TEXT LIKE CONCAT('%', #{searchText}, '%')
                )
            </if>
        </where>
    </sql>

    <!-- 예약 메시지 목록 조회 (그룹핑) -->
    <select id="selectScheduledMessages" resultMap="scheduledMessageResultMap">
        SELECT
            MIN(M_SEQ) as M_SEQ,
            MSG_TYPE,
            MIN(DST_ADDR) as DST_ADDR,
            CALLBACK,
            STAT,
            SUBJECT,
            TEXT,
            INSERT_TIME,
            REQUEST_TIME,
            EXT_COL2,
            EXT_COL3,
            COUNT(*) as MESSAGE_COUNT,
            MAX(FILE_CNT) as FILE_CNT
        FROM sc_tran
        <include refid="whereCondition"/>
        GROUP BY MSG_TYPE, CALLBACK, SUBJECT, TEXT, INSERT_TIME, REQUEST_TIME, EXT_COL2, EXT_COL3, STAT
        ORDER BY REQUEST_TIME ASC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 예약 메시지 총 건수 (그룹핑) -->
    <select id="countScheduledMessages" resultType="int">
        SELECT COUNT(*)
        FROM (
            SELECT 1
            FROM sc_tran
            <include refid="whereCondition"/>
            GROUP BY MSG_TYPE, CALLBACK, SUBJECT, TEXT, INSERT_TIME, REQUEST_TIME, EXT_COL2, EXT_COL3, STAT
        ) t
    </select>

    <!-- 예약 메시지 상세 조회 -->
    <select id="selectMessageById" resultMap="scheduledMessageResultMap">
        SELECT
            M_SEQ,
            MSG_TYPE,
            DST_ADDR,
            CALLBACK,
            STAT,
            SUBJECT,
            TEXT,
            INSERT_TIME,
            REQUEST_TIME,
            SENDER_CODE,
            EXT_COL0,
            EXT_COL1,
            EXT_COL2,
            EXT_COL3,
            FILE_CNT,
            FILE_LOC1,
            FILE_LOC2,
            FILE_LOC3,
            FILE_LOC4,
            FILE_LOC5
        FROM sc_tran
        WHERE M_SEQ = #{mSeq}
        <if test="userId != null and userId != '' and userId != 'ALL'">
            <choose>
                <when test="userId.contains(',')">
                    AND EXT_COL3 IN
                    <foreach item="id" collection="userId.split(',')" open="(" separator="," close=")">
                        #{id}
                    </foreach>
                </when>
                <otherwise>
                    AND EXT_COL3 = #{userId}
                </otherwise>
            </choose>
        </if>
    </select>

    <!-- 그룹 예약 시간 변경 -->
    <update id="updateGroupRequestTime">
        UPDATE sc_tran
        SET REQUEST_TIME = #{newRequestTime}
        WHERE EXT_COL3 = #{userId}
        AND MSG_TYPE = #{msgType}
        AND INSERT_TIME = #{insertTime}
        AND STAT = 0
    </update>

    <!-- 그룹 예약 메시지 삭제 -->
    <delete id="deleteScheduledMessageGroup">
        DELETE FROM sc_tran
        WHERE EXT_COL3 = #{userId}
        AND MSG_TYPE = #{msgType}
        AND INSERT_TIME = #{insertTime}
        AND STAT = 0
    </delete>

    <!-- 삭제 대상 메시지 건수 조회 -->
    <select id="countMessagesForCancellation" resultType="int">
        SELECT COUNT(*)
        FROM sc_tran
        WHERE EXT_COL3 = #{userId}
        AND MSG_TYPE = #{msgType}
        AND INSERT_TIME = #{insertTime}
        AND STAT = 0
    </select>

</mapper>
